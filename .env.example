# Server
PORT=4000
NODE_ENV=development

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/calendar

# JWT Secrets (genera valores seguros y únicos)
SECRET_ACCESS_TOKEN=your_access_token_secret
SECRET_REFRESH_TOKEN=your_refresh_token_secret

# Email (Gmail SMTP)
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Frontend paths for email links
RESET_PASSWORD=/auth/reset-password?q=
VERIFIED_EMAIL=/auth/verified?q=
